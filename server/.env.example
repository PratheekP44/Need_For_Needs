NODE_ENV=development
PORT=5000
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/campus_essentials
# Atlas (SRV):
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/needforneeds?retryWrites=true&w=majority&appName=Cluster0
# Optional fallback standard URI if SRV is blocked in your network:
# MONGODB_STANDARD_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/needforneeds?ssl=true&replicaSet=...&authSource=admin
# Comma-separated allowlist, or *. In non-production, localhost / 127.0.0.1
# on ANY port are also allowed automatically (Flutter Web random ports).
# Persistent uploads directory (Render disk mount). Without this, files live on
# the ephemeral filesystem and disappear on redeploy while MongoDB paths remain.
# UPLOADS_DIR=/var/data/uploads
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# JWT (required)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unlock JWT (required) — dedicated secret; do NOT reuse auth JWT secrets.
UNLOCK_JWT_SECRET=change_me_unlock_jwt_secret_min_32_chars_long
# Lifetime in seconds (default 600 = 10 minutes)
UNLOCK_JWT_TTL_SECONDS=600

# Password hashing
ORDER_RESERVATION_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# Razorpay TEST MODE (required)
# Key Secret stays on the server only — never put it in Flutter.
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
# RAZORPAY_MOCK is no longer used — mock gateway has been removed.
