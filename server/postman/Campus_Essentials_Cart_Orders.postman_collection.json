{
  "info": {
    "_postman_id": "campus-essentials-cart-orders-phase8",
    "name": "Campus Essentials - Cart & Orders",
    "description": "Phase 8 Cart and Order Management APIs (no Razorpay).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userAccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "stockId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderNumber", "value": "" }
  ],
  "item": [
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Add to Cart",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j=pm.response.json();",
                "if(j.data&&j.data.cart&&j.data.cart.items[0]){",
                "  pm.collectionVariables.set('cartItemId', j.data.cart.items[0].id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockId\": \"{{stockId}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/cart/add"
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartItemId\": \"{{cartItemId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/cart/update"
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/cart/remove/{{cartItemId}}"
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/cart/clear"
          }
        }
      ]
    },
    {
      "name": "Checkout & Orders",
      "item": [
        {
          "name": "Checkout",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j=pm.response.json();",
                "if(j.data&&j.data.order){",
                "  pm.collectionVariables.set('orderId', j.data.order.id);",
                "  pm.collectionVariables.set('orderNumber', j.data.order.orderNumber);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discount\": 0\n}"
            },
            "url": "{{baseUrl}}/checkout"
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/orders?page=1&limit=20&sort=-createdAt"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel"
          }
        }
      ]
    }
  ]
}
